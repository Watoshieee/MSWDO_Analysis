/* -- DATA BRIDGE ----------------------------------------------------------- */
const AN = {
    muni: {{ json_encode($municipality->name) }},
    year: {{ $analysisYear }},
    kpis: {
        pop:   {{ $totalPop ?? 0 }},
        hh:    {{ $totalHouseholds ?? 0 }},
        apps:  {{ $totalApplications ?? 0 }},
        uniq:  {{ $uniqueApplicants ?? 0 }},
        appr:  {{ $approvedApplications ?? 0 }},
        pend:  {{ $pendingApplications ?? 0 }},
        rej:   {{ $rejectedApplications ?? 0 }},
        benef: {{ $totalBeneficiaries ?? 0 }},
    },
    trend: {!! json_encode($trendRows->map(fn($r, $yr) => [
        'year' => (int)$yr,
        'pop'  => (int)($r->total_population ?? 0),
        'hh'   => (int)($r->total_households ?? 0),
    ])->values()) !!},
    programs: {!! json_encode($programShareOverview->mapWithKeys(fn($v,$k) => [str_replace('_',' ',$k) => (int)$v])) !!},
    apps: {!! json_encode($appProgs->mapWithKeys(fn($v,$k) => [
        str_replace('_',' ',$k) => [
            'total' => $v['total'],
            'pend'  => $v['pending'] ?? 0,
            'appr'  => $v['approved'] ?? 0,
            'rej'   => $v['rejected'] ?? 0,
        ]
    ])) !!},
    gender: { male: {{ $genderData['male'] ?? 0 }}, female: {{ $genderData['female'] ?? 0 }} },
    barangays: {!! json_encode(isset($barangayRowsForAnalysis) && $barangayRowsForAnalysis->isNotEmpty()
        ? $barangayRowsForAnalysis->map(fn($b) => ['name' => $b->name, 'pop' => ($b->male_population ?? 0) + ($b->female_population ?? 0)])->sortByDesc('pop')->values()
        : collect()) !!},
};
const FMT = n => n == null || n === '' ? '—' : Number(n).toLocaleString();

/* -- EXPORT DROPDOWN ------------------------------------------------------- */
(function() {
    const btn = document.getElementById('exBtn');
    const menu = document.getElementById('exMenu');
    if (!btn || !menu) return;
    btn.addEventListener('click', e => {
        e.stopPropagation();
        const open = !menu.hidden;
        menu.hidden = open;
        btn.setAttribute('aria-expanded', String(!open));
    });
    document.addEventListener('click', e => {
        if (!menu.hidden && !e.target.closest('#exBtn') && !e.target.closest('#exMenu')) {
            menu.hidden = true;
            btn.setAttribute('aria-expanded', 'false');
        }
    });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !menu.hidden) {
            menu.hidden = true;
            btn.setAttribute('aria-expanded', 'false');
            btn.focus();
        }
    });
})();

/* -- PROGRAM FILTER -------------------------------------------------------- */
const allProgs = new Set([...document.querySelectorAll('[data-chip-prog]')].map(el => el.dataset.chipProg));
let selProgs = new Set(allProgs);

function toggleProg(chipEl) {
    const p = chipEl.dataset.chipProg;
    if (selProgs.has(p)) {
        if (selProgs.size === 1) return;
        selProgs.delete(p);
        chipEl.classList.remove('on');
        chipEl.setAttribute('aria-pressed', 'false');
    } else {
        selProgs.add(p);
        chipEl.classList.add('on');
        chipEl.setAttribute('aria-pressed', 'true');
    }
    applyFilter();
}

function applyFilter() {
    document.querySelectorAll('[data-prog-row]').forEach(el => {
        el.hidden = !selProgs.has(el.dataset.progRow);
    });
    const n = selProgs.size, t = allProgs.size;
    const sc = document.getElementById('progSelCount');
    const cl = document.getElementById('progCountLabel');
    if (sc) sc.textContent = n;
    if (cl) cl.textContent = n;
    const rl = document.getElementById('resetLink');
    if (rl) rl.hidden = (n === t);
}

document.getElementById('resetLink')?.addEventListener('click', e => {
    e.preventDefault();
    selProgs = new Set(allProgs);
    document.querySelectorAll('[data-chip-prog]').forEach(el => {
        el.classList.add('on');
        el.setAttribute('aria-pressed', 'true');
    });
    applyFilter();
});

/* -- VIEW REPORT MODAL ----------------------------------------------------- */
const VR_TABS = ['Summary','Applications','Programs','Demographics','Barangays'];
let vrCurTab = 0;

function vrContent(i) {
    const d = AN;
    if (i === 0) {
        const rows = [['Municipality',d.muni],['Data year',d.year],['Total population',FMT(d.kpis.pop)||'—'],['Households',FMT(d.kpis.hh)||'—'],['Applications',FMT(d.kpis.apps)],['Unique applicants',FMT(d.kpis.uniq)||'—'],['Approved',FMT(d.kpis.appr)],['Pending',FMT(d.kpis.pend)],['Rejected',FMT(d.kpis.rej)],['Total beneficiaries',FMT(d.kpis.benef)||'—']];
        return `<p class="md-cap"><b>Key figures</b><span>All values for ${d.year}</span></p><div class="tw"><table><thead><tr><th class="l" style="text-align:left">Metric</th><th>Value</th></tr></thead><tbody>${rows.map(([k,v])=>`<tr><th scope="row" style="text-align:left;font-weight:600">${k}</th><td>${v}</td></tr>`).join('')}</tbody></table></div>`;
    }
    if (i === 1) {
        const progs = Object.entries(d.apps);
        if (!progs.length) return '<div class="ms"><b>No applications</b><p>No application records for this year.</p></div>';
        const tot = progs.reduce((a,[,v])=>({total:a.total+v.total,pend:a.pend+v.pend,appr:a.appr+v.appr,rej:a.rej+v.rej}),{total:0,pend:0,appr:0,rej:0});
        return `<p class="md-cap"><b>Applications</b><span>${d.year}</span></p><div class="tw"><table><thead><tr><th>Program</th><th>Total</th><th>Pending</th><th>Approved</th><th>Rejected</th></tr></thead><tbody>${progs.map(([k,v])=>`<tr><th scope="row">${k}</th><td>${FMT(v.total)}</td><td>${FMT(v.pend)}</td><td>${FMT(v.appr)}</td><td>${FMT(v.rej)}</td></tr>`).join('')}<tr><th scope="row" style="font-weight:700">Total</th><td style="font-weight:700">${FMT(tot.total)}</td><td style="font-weight:700">${FMT(tot.pend)}</td><td style="font-weight:700">${FMT(tot.appr)}</td><td style="font-weight:700">${FMT(tot.rej)}</td></tr></tbody></table></div>`;
    }
    if (i === 2) {
        const progs = Object.entries(d.programs);
        if (!progs.length) return '<div class="ms"><b>No programs</b><p>No beneficiary records for this year.</p></div>';
        return `<p class="md-cap"><b>Beneficiaries by program</b><span>${d.year}</span></p><div class="tw"><table><thead><tr><th>Program</th><th>Beneficiaries ${d.year}</th></tr></thead><tbody>${progs.map(([k,v])=>`<tr><th scope="row">${k}</th><td>${FMT(v)}</td></tr>`).join('')}</tbody></table></div>`;
    }
    if (i === 3) {
        const gt = d.gender.male + d.gender.female;
        const mp = gt > 0 ? Math.round(d.gender.male/gt*100) : null;
        return `<p class="md-cap"><b>Gender distribution</b><span>${d.year}</span></p><div class="tw"><table><thead><tr><th>Category</th><th>Count</th><th>Share</th></tr></thead><tbody><tr><th scope="row">Male</th><td>${FMT(d.gender.male||null)}</td><td>${mp!=null?mp+'%':'—'}</td></tr><tr><th scope="row">Female</th><td>${FMT(d.gender.female||null)}</td><td>${mp!=null?(100-mp)+'%':'—'}</td></tr><tr><th scope="row" style="font-weight:700">Total</th><td style="font-weight:700">${FMT(gt||null)}</td><td style="font-weight:700">100%</td></tr></tbody></table></div>`;
    }
    if (i === 4) {
        const bgys = d.barangays;
        if (!bgys || !bgys.length) return '<div class="ms"><b>No barangay data</b><p>No barangay records for this year.</p></div>';
        return `<p class="md-cap"><b>Population by barangay</b><span>${d.year}</span></p><div class="tw"><table><thead><tr><th>Barangay</th><th>Population</th></tr></thead><tbody>${bgys.map((b,i)=>`<tr><th scope="row">#${i+1} ${b.name}</th><td>${b.pop?FMT(b.pop):'—'}</td></tr>`).join('')}</tbody></table></div><p class="fn">"—" = no record, not zero.</p>`;
    }
    return '';
}

function vrRenderTabs() {
    const tabs = document.getElementById('vrTabs');
    if (!tabs) return;
    tabs.innerHTML = VR_TABS.map((t,i) => `<button class="chip${i===vrCurTab?' on':''}" data-vr-tab="${i}" role="tab" aria-selected="${i===vrCurTab}">${t}</button>`).join('');
}
function vrRenderBody() {
    const bd = document.getElementById('vrBd');
    if (!bd) return;
    bd.innerHTML = vrContent(vrCurTab);
    bd.scrollTop = 0;
}

document.getElementById('vrBtn')?.addEventListener('click', () => {
    vrCurTab = 0;
    const modal = document.getElementById('vrModal');
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    vrRenderTabs();
    vrRenderBody();
    document.getElementById('vrClose')?.focus();
});

document.getElementById('vrClose')?.addEventListener('click', closeVrModal);
document.getElementById('vrModal')?.addEventListener('click', e => {
    if (e.target === e.currentTarget) closeVrModal();
});
document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !document.getElementById('vrModal')?.hidden) closeVrModal();
});
document.getElementById('vrTabs')?.addEventListener('click', e => {
    const btn = e.target.closest('[data-vr-tab]');
    if (!btn) return;
    vrCurTab = +btn.dataset.vrTab;
    vrRenderTabs();
    vrRenderBody();
    btn.focus();
});
function closeVrModal() {
    const m = document.getElementById('vrModal');
    if (m) { m.hidden = true; document.body.style.overflow = ''; }
    document.getElementById('vrBtn')?.focus();
}
</script>
</body>
</html>

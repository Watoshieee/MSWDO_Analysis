@@keyframes mdf{from{opacity:0}}
.md{display:flex;flex-direction:column;width:min(960px,100%);max-height:min(86vh,820px);background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 24px 60px rgba(20,27,77,.4);animation:mdu .22s cubic-bezier(.2,.8,.2,1)}
@@keyframes mdu{from{opacity:0;transform:translateY(14px)}}
.md-hd{position:relative;overflow:hidden;flex:none;display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:20px 22px 18px;background:linear-gradient(135deg,#1a2470,#243088);color:#fff}
.md-hd::after{content:"";position:absolute;width:260px;height:260px;right:-60px;top:-110px;border-radius:50%;background:rgba(255,255,255,.05);pointer-events:none}
.md-hd>*{position:relative;z-index:1}
.md-eb{display:inline-block;padding:3px 12px;border-radius:99px;background:rgba(245,184,46,.16);border:1px solid rgba(245,184,46,.45);color:var(--gd);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.md-hd h2{margin:10px 0 0;font-size:22px;font-weight:800;letter-spacing:-.01em;line-height:1.2}
.md-bar{display:block;width:40px;height:3px;border-radius:3px;background:var(--gd);margin:8px 0}
.md-hd p{font-size:13px;color:#dbe0f7}
.md-x{flex:none;display:grid;place-items:center;width:38px;height:38px;border:0;border-radius:99px;background:rgba(255,255,255,.12);color:#fff;cursor:pointer;padding:0}
.md-x:hover{background:rgba(255,255,255,.22)}
.md-tabs{flex:none;display:flex;gap:6px;overflow-x:auto;padding:12px 18px;background:var(--bg);border-bottom:1px solid var(--ln)}
.md-tabs .chip{flex:none;min-height:36px;padding:0 12px;font-size:13px}
.md-bd{flex:1;min-height:0;overflow:auto;padding:16px 18px}
.md-bd .tw{margin-top:0}
.md-cap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 12px;margin-bottom:10px;font-size:12.5px;color:var(--mut)}

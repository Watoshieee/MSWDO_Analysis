@@media(max-width:640px){.md-scrim{padding:0;align-items:end}.md{width:100%;max-height:92vh;border-radius:16px 16px 0 0}.md-hd{padding:16px 16px 14px}.md-hd h2{font-size:19px}.md-bd{padding:12px}.md-act{width:100%}.md-b{flex:1;justify-content:center;min-height:44px}.md-ft p{display:none}}

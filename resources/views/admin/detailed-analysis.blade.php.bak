<style>
/* -- TOKENS ---------------------------------------------------- */
:root{--nv:#1e2a78;--nvd:#1a2470;--nvl:#243088;--gd:#f5b82e;--ink:#1b2559;--mut:#4d5878;--ln:#dbe1f1;--bg:#f4f6fb;--tnt:#eef1fb;--bad:#d4545c;--sft:#eef1f8;--ok:#1a7f47}
*{box-sizing:border-box}
html,body{margin:0;padding:0;overscroll-behavior:none}
body{background:var(--bg);font-family:'Inter',sans-serif;color:var(--ink);font-size:14px;line-height:1.5;display:flex;flex-direction:column;min-height:100vh}
a{color:var(--nv);text-decoration:none}
h1,h2,h3,p{margin:0}

/* -- NAVBAR ---------------------------------------------------- */
.navbar{background:linear-gradient(90deg,#1a2470,#243088)!important;box-shadow:0 4px 24px rgba(44,62,143,.18);padding:14px 0}
.navbar-brand{font-weight:800;font-size:1.55rem;color:white!important;display:flex;align-items:center;gap:12px;order:0;margin-left:auto!important;margin-right:0!important}
.navbar-toggler{order:-1}
@@media(min-width:992px){.navbar-toggler{order:0}.navbar-brand{margin-left:0!important;margin-right:auto!important}}
.nav-link{color:rgba(255,255,255,.88)!important;font-weight:600;transition:all .25s;border-radius:8px;padding:10px 18px!important;font-size:.85rem;white-space:nowrap}
.nav-link:hover{background:rgba(255,255,255,.15);color:white!important}
.nav-link.active{background:var(--gd);color:var(--nv)!important;font-weight:700}
.user-info{color:white;display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.1);padding:9px 22px;border-radius:40px;font-size:.9rem;font-weight:600}
.logout-btn{background:transparent;border:2px solid rgba(255,255,255,.8);color:white;border-radius:30px;padding:6px 18px;font-weight:700;transition:all .3s;font-size:.88rem;cursor:pointer}
.logout-btn:hover{background:var(--gd);color:var(--nv);border-color:var(--gd)}

/* -- LAYOUT ---------------------------------------------------- */
.pg-in{max-width:1440px;margin:0 auto;padding:0 40px}
.pg-main{max-width:1440px;margin:0 auto;padding:28px 40px 96px;display:grid;gap:16px;flex:1}
@@media(max-width:900px){.pg-in{padding:0 24px}.pg-main{padding:20px 24px 96px}}

/* -- HERO ------------------------------------------------------ */
.hero{background:linear-gradient(135deg,#1a2470 0%,#243088 100%);color:#fff;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.05);width:320px;height:320px;left:-80px;top:40px;pointer-events:none}
.hero::after{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.05);width:380px;height:380px;right:-60px;top:-60px;pointer-events:none}
.hero-in{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;padding:52px 0 48px}
.eyebrow{display:inline-block;padding:7px 20px;border-radius:99px;background:rgba(245,184,46,.16);border:1px solid rgba(245,184,46,.45);color:var(--gd);font-size:13px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.hero h1{margin:14px 0 0;font-size:40px;font-weight:800;letter-spacing:-.02em;line-height:1.15}
.hero .bar{display:block;width:56px;height:4px;border-radius:4px;background:var(--gd);margin:14px 0 16px}
.hero p{font-size:16px;color:#dbe0f7;max-width:640px}
.muni-box{border:1px solid rgba(245,184,46,.45);background:rgba(245,184,46,.14);border-radius:14px;padding:18px 32px;text-align:center}
.muni-box b{display:block;font-size:28px;font-weight:800;color:var(--gd);line-height:1.2}
.muni-box span{display:block;margin-top:6px;font-size:13px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#e3bf63}
@@media(max-width:640px){.hero h1{font-size:30px}.hero-in{padding:32px 0 30px}}

/* -- FILTER BAR ------------------------------------------------ */
.fb{background:#fff;border:1px solid var(--ln);border-radius:14px;padding:16px;display:grid;gap:12px}
.seg{display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.lbl{font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--mut);white-space:nowrap;margin-right:2px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{display:inline-flex;align-items:center;gap:5px;padding:0 16px;height:36px;border-radius:99px;border:1.5px solid var(--ln);background:#fff;color:var(--nv);font-size:13.5px;font-weight:600;cursor:pointer;text-decoration:none;transition:border-color .15s,background .15s,color .15s;white-space:nowrap;-webkit-user-select:none;user-select:none;min-height:36px}
.chip:hover{border-color:var(--nv);background:var(--tnt);color:var(--nv)}
.chip.on{background:var(--nv);border-color:var(--nv);color:#fff}
.chip .chk{opacity:0;transition:opacity .15s;flex:none}
.chip.on .chk{opacity:1}
.grp{border:1px solid var(--ln);border-radius:10px}
.grp summary{padding:10px 14px;font-size:13px;font-weight:600;color:var(--ink);cursor:pointer;display:flex;align-items:center;gap:6px;list-style:none;-webkit-user-select:none;user-select:none}
.grp summary::-webkit-details-marker{display:none}
.chev{margin-left:auto;color:var(--mut);transition:transform .2s;flex:none}
.grp[open] .chev{transform:rotate(180deg)}
.grp-bd{padding:8px 14px 12px;display:flex;flex-wrap:wrap;gap:8px;border-top:1px solid var(--ln)}
.fb-row2{display:flex;align-items:center;flex-wrap:wrap;gap:10px;padding-top:8px;border-top:1px solid var(--sft)}
.fb-info{font-size:13px;color:var(--mut);flex:1;min-width:0}
.fb-info b{color:var(--ink);font-weight:700}
.rs{font-size:12.5px;font-weight:600;color:var(--bad);text-decoration:none;white-space:nowrap}
.rs:hover{text-decoration:underline}
.exg{display:flex;align-items:center;gap:8px;margin-left:auto;flex-wrap:nowrap}
.vr-btn{display:inline-flex;align-items:center;gap:6px;padding:0 16px;height:40px;border-radius:10px;border:1.5px solid var(--ln);background:#fff;color:var(--nv);font-weight:700;font-size:13px;cursor:pointer;transition:all .15s;white-space:nowrap}
.vr-btn:hover{background:var(--tnt);border-color:var(--nv)}
.ex-wrap{position:relative}
.ex-btn{display:inline-flex;align-items:center;gap:6px;padding:0 16px;height:40px;border-radius:10px;border:1.5px solid var(--gd);background:var(--gd);color:#1a2470;font-weight:700;font-size:13px;cursor:pointer;transition:all .15s;white-space:nowrap}
.ex-btn:hover{background:#e8a81e;border-color:#e8a81e}
.ex-btn svg:last-child{transition:transform .15s}
.ex-btn[aria-expanded=true] svg:last-child{transform:rotate(180deg)}
.ex-menu{position:absolute;right:0;top:calc(100% + 6px);z-index:30;width:260px;background:#fff;border:1px solid var(--ln);border-radius:12px;box-shadow:0 12px 28px rgba(20,27,77,.18);padding:6px}
.ex-menu[hidden]{display:none}
.ex-hd{font-size:11.5px;color:var(--mut);padding:8px 10px 10px;border-bottom:1px solid var(--sft);margin-bottom:4px}
.ex-hd b{display:block;font-size:13px;color:var(--ink);font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:2px}
.ex-it{display:flex;align-items:center;gap:12px;width:100%;min-height:52px;padding:6px 10px;border:0;border-radius:8px;background:none;text-align:left;text-decoration:none;color:var(--ink)}
.ex-it:hover{background:var(--bg)}
.ex-ic{flex:none;display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:var(--tnt);color:var(--nv)}
.ex-it b{display:block;font-size:13px;font-weight:700}
.ex-it small{display:block;font-size:11.5px;color:var(--mut)}
@@media(max-width:560px){.chip{min-height:44px}.exg{width:100%}.vr-btn,.ex-btn{flex:1;justify-content:center;min-height:44px}.ex-menu{left:0;right:0;width:auto}}

/* -- KPI CARDS ------------------------------------------------- */
.kp{display:flex;flex-wrap:wrap;gap:12px}
.k{flex:1 1 170px;max-width:calc((100% - 60px) / 6);position:relative;overflow:hidden;background:#fff;border:1px solid var(--ln);border-radius:12px;padding:16px 14px 14px;min-width:0}
.k::before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--nv)}
.k>span{display:block;font-size:11.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--mut)}
.k b{display:block;font-size:26px;line-height:1.2;font-weight:800;color:var(--nv);margin:4px 0;overflow-wrap:anywhere}
.k b.na{font-size:15px;color:#7a84a8;font-weight:600;padding:6px 0}
.k small{font-size:12px;color:var(--mut)}
.up{display:inline-block;background:#e3f6ea;color:#14663a;border-radius:99px;padding:1px 8px;font-weight:600;font-size:12px}
@@@media(max-width:1200px){.k{max-width:calc((100% - 50px) / 5)}}@@@media(max-width:900px){.k{max-width:calc((100% - 36px) / 4)}}@@@media(max-width:640px){.k{max-width:calc(50% - 6px);flex-basis:calc(50% - 6px)}}@@@media(max-width:400px){.k{max-width:100%;flex-basis:100%}}

/* -- CARDS ----------------------------------------------------- */
.cd{background:#fff;border:1px solid var(--ln);border-radius:14px;box-shadow:0 1px 2px rgba(23,32,102,.06),0 6px 16px -10px rgba(23,32,102,.16);min-width:0;overflow:hidden}
.ch{padding:16px 18px 12px;border-bottom:1px solid var(--sft)}
.ch h2{font-size:17px;font-weight:800;color:var(--ink)}
.ch h2::after{content:"";display:block;width:28px;height:3px;border-radius:3px;background:var(--gd);margin-top:6px}
.ch p{color:var(--mut);font-size:12.5px;margin-top:6px}
.bd{padding:16px 18px}

/* -- TWO-COL GRID ---------------------------------------------- */
.two{display:grid;gap:16px}
.two>.cd{display:flex;flex-direction:column}
.two>.cd>.bd{flex:1}
@@media(min-width:1000px){.two{grid-template-columns:minmax(0,5fr) minmax(0,7fr)}.two.eq{grid-template-columns:1fr 1fr}}

/* -- TREND ROWS ------------------------------------------------ */
.tr{display:grid;grid-template-columns:52px minmax(0,1fr);gap:10px;padding:8px 6px;border-radius:10px;align-items:start}
.tr.on{background:#fff6dc}
.tr>strong{font-weight:800;color:var(--nv);font-size:13.5px;padding-top:3px}
.br{display:grid;grid-template-columns:82px minmax(0,1fr) 64px;gap:8px;align-items:center;margin:3px 0}
.br span{font-size:11.5px;color:var(--mut);font-weight:600}
.br div{height:12px;background:var(--tnt);border-radius:6px;overflow:hidden}
.br i{display:block;height:100%;border-radius:6px;min-width:2px}
.br em{font-style:normal;font-weight:700;font-size:12px;text-align:right;color:var(--ink)}

/* -- LEGEND ---------------------------------------------------- */
.lg{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:12.5px;color:var(--mut);margin-bottom:8px}
.sw{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:middle}

/* -- PROGRAM BARS ---------------------------------------------- */
.pr{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;padding:8px 0;border-top:1px solid var(--sft)}
.pr:first-of-type{border-top:none}
.pr .nm{font-size:13px;font-weight:600;color:var(--ink);grid-column:1;overflow-wrap:anywhere}
.pr .v{font-size:13px;font-weight:700;color:var(--nv);grid-column:2;grid-row:1/3;align-self:center;text-align:right;white-space:nowrap}
.tk{grid-column:1/-1;height:8px;border-radius:8px;background:var(--sft);overflow:hidden;display:flex}
.tk i{display:block;height:100%;min-width:2px}

/* -- STATUS BAR ------------------------------------------------ */
.seg-bar{height:14px;border-radius:7px;display:flex;overflow:hidden;margin:8px 0}
.seg-bar i{display:block;height:100%}

/* -- TABLES ---------------------------------------------------- */
.tw{overflow-x:auto;border:1px solid var(--ln);border-radius:10px;margin-top:6px;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:9px 12px;text-align:right;border-top:1px solid var(--sft);white-space:nowrap}
thead th{background:var(--bg);font-size:12px;color:var(--mut);font-weight:700;text-transform:uppercase;letter-spacing:.04em;border-top:0;border-bottom:2px solid var(--ln)}
th:first-child,td:first-child{text-align:left;position:sticky;left:0;background:#fff;white-space:normal;min-width:140px;overflow-wrap:anywhere}
thead th:first-child{background:var(--bg)}
.sel{background:#fff6dc!important;font-weight:700}
@@media(max-width:560px){.stk thead{display:none}.stk,.stk tbody{display:block}.stk tr{display:block;border:1px solid var(--ln);border-radius:10px;margin:8px;padding:8px 12px}.stk td,.stk th{display:flex;justify-content:space-between;gap:12px;border:0;padding:3px 0;position:static;min-width:0;white-space:normal}.stk td::before{content:attr(data-l);color:var(--mut);font-weight:600}.stk th:first-child{font-size:14px;color:var(--nv);padding-bottom:6px}.tw{border:0}}

/* -- GENDER RING ----------------------------------------------- */
.dn{display:grid;justify-items:center;gap:16px;padding:6px 0}
.ring{width:min(210px,62%);aspect-ratio:1;border-radius:50%;display:grid;place-items:center}
.ring>div{width:64%;aspect-ratio:1;border-radius:50%;background:#fff;display:grid;place-content:center;text-align:center}
.ring b{font-size:24px;line-height:1.1;color:var(--nv);font-weight:800;display:block}
.ring small{color:var(--mut);font-size:12px;display:block}
.bd:has(>.dn){display:flex;flex-direction:column;justify-content:center}

/* -- BARANGAY SCROLL LIST -------------------------------------- */
.bl{max-height:340px;overflow-y:auto;overflow-x:hidden;padding-right:4px}
.bl::-webkit-scrollbar{width:4px}
.bl::-webkit-scrollbar-thumb{background:var(--ln);border-radius:4px}

/* -- EMPTY STATE ----------------------------------------------- */
.ms{text-align:center;padding:28px 16px;display:grid;justify-items:center;gap:8px}
.ms b{font-size:15px;color:var(--ink);font-weight:700}
.ms p{color:var(--mut);max-width:38ch;font-size:13px}
.ms-btn{display:inline-flex;align-items:center;gap:6px;margin-top:8px;padding:8px 16px;background:var(--nv);color:#fff;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;transition:background .15s}
.ms-btn:hover{background:var(--nvl);color:#fff}

/* -- FOOTNOTE -------------------------------------------------- */
.fn{font-size:12px;color:var(--mut);margin-top:8px}
.na{color:#7a84a8;font-style:italic;font-size:12.5px}

/* -- FOOTER ---------------------------------------------------- */
